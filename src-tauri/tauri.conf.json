{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "habit_levelling",
  "version": "0.3.0",
  "identifier": "com.habitlevelling.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Habit Levelling",
        "width": 1120,
        "height": 800,
        "center": true,
        "minWidth": 520,
        "minHeight": 480,
        "theme": "Dark",
        "backgroundColor": "#0a0b0f"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
